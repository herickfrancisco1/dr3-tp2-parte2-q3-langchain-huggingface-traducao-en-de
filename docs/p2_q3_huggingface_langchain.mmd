flowchart TB
    C(["Cliente"]) <-- "POST /translate {text: inglês}<br/>⟵ 200 JSON {translated_text, chunks, elapsed_ms}" --> V
    subgraph API["FastAPI · uvicorn"]
        direction LR
        V["Validação Pydantic<br/>TranslationRequest"] --> R["Rota /translate<br/>(def → thread pool)"]
        R --> T["LangChainTranslator<br/>segmentação parágrafo → frase<br/>+ remontagem do texto"]
    end
    subgraph LC["LangChain · cadeia LCEL"]
        direction LR
        P["PromptTemplate '{text}'<br/>(repasse: Marian não<br/>segue instruções)"] --> L["HuggingFacePipeline<br/>(BaseLLM · batch_size=8)"]
        L --> O["StrOutputParser"]
    end
    subgraph HF["HuggingFace transformers (processo local)"]
        direction LR
        PL["pipeline('translation')"] --> TK["MarianTokenizer<br/>(sentencepiece)"]
        TK --> M["MarianMT opus-mt-en-de<br/>~74M parâmetros · CPU/GPU"]
    end
    T <-- "chain.batch([trechos]) ⟶<br/>⟵ trechos em alemão" --> P
    L <-- "lote de textos ⟶<br/>⟵ translation_text" --> PL
    HUB[("HuggingFace Hub<br/>cache ~/.cache/huggingface")] -. "from_model_id(): download<br/>+ carga 1x no startup" .-> M
    classDef ext fill:#eef2ff,stroke:#6366f1,color:#111;
    classDef api fill:#ecfdf5,stroke:#10b981,color:#111;
    classDef lc fill:#f0f9ff,stroke:#0ea5e9,color:#111;
    classDef hf fill:#fff7ed,stroke:#f59e0b,color:#111;
    class C,HUB ext; class V,R,T api; class P,L,O lc; class PL,TK,M hf;
